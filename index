<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cyber Roulette 賽博輪盤賭</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 20px;
      min-height: 100vh;
      background: #0b0711;
      color: #fff;
      font-family: Arial, Helvetica, sans-serif;
      display: flex;
      justify-content: center;
      align-items: flex-start;
    }

    .main-card {
      width: 100%;
      max-width: 520px;
      padding: 20px;
      border: 1px solid #3d2563;
      border-radius: 16px;
      background: linear-gradient(145deg, #160e24, #1f1433);
      box-shadow: 0 8px 30px rgba(138, 43, 226, .2);
    }

    .top-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 12px;
      margin-bottom: 15px;
      border-bottom: 1px solid #3d2563;
    }

    .game-title {
      margin: 0;
      font-size: 20px;
      font-weight: bold;
      color: #00f2fe;
      text-shadow: 0 0 8px rgba(0, 242, 254, .35);
    }

    .money-display {
      color: #00ffcc;
      font-size: 20px;
      font-weight: bold;
      text-shadow: 0 0 8px rgba(0, 255, 204, .5);
    }

    #info-text {
      margin-bottom: 12px;
      color: #a08dc0;
      font-size: 14px;
      text-align: center;
      min-height: 20px;
    }

    /* 輪盤區容器 */
    .roulette-wrapper {
      position: relative;
      width: 280px;
      height: 280px;
      margin: 0 auto 15px auto;
    }

    #roulette-canvas {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      box-shadow: 0 0 20px rgba(0, 242, 254, .2);
    }

    .pointer {
      position: absolute;
      top: -10px;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 0;
      border-left: 12px solid transparent;
      border-right: 12px solid transparent;
      border-top: 20px solid #ff0055;
      z-index: 10;
      filter: drop-shadow(0 0 6px #ff0055);
    }

    /* 下注板網格 */
    .betting-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
      margin-bottom: 12px;
    }

    .bet-btn {
      padding: 10px 5px;
      border: 1px solid #482f75;
      border-radius: 8px;
      background: #2a1b45;
      color: white;
      font-size: 13px;
      font-weight: bold;
      cursor: pointer;
      transition: .15s;
    }

    .bet-btn:hover:not(:disabled) {
      background: #38245c;
      border-color: #00f2fe;
    }

    .bet-btn.selected {
      border-color: #00ffcc;
      background: #0d382c;
      box-shadow: 0 0 10px rgba(0, 255, 204, .4);
    }

    .bet-btn.red-bg { border-left: 4px solid #ff0055; }
    .bet-btn.black-bg { border-left: 4px solid #a08dc0; }

    /* 單數字選擇器 */
    .single-num-box {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 15px;
      padding: 8px;
      background: #11091c;
      border: 1px solid #2a1b45;
      border-radius: 8px;
    }

    .single-num-box label {
      font-size: 12px;
      color: #a08dc0;
      white-space: nowrap;
    }

    .single-num-box input {
      width: 100%;
      padding: 6px;
      border: 1px solid #3d2563;
      border-radius: 6px;
      background: #180e2b;
      color: #fff;
    }

    /* 控制面板 */
    .control-box {
      padding: 15px;
      border: 1px solid #2a1b45;
      border-radius: 12px;
      background: #11091c;
    }

    .input-row {
      display: flex;
      gap: 10px;
      margin-bottom: 12px;
    }

    .input-group {
      flex: 1;
    }

    .input-group label {
      display: block;
      margin-bottom: 6px;
      color: #a08dc0;
      font-size: 12px;
    }

    .input-group input {
      width: 100%;
      padding: 10px;
      border: 1px solid #3d2563;
      border-radius: 8px;
      outline: none;
      background: #180e2b;
      color: #fff;
    }

    .btn-action {
      height: 38px;
      margin-top: 22px;
      padding: 0 15px;
      border: 1px solid #624396;
      border-radius: 8px;
      background: #482f75;
      color: #fff;
      font-weight: bold;
      cursor: pointer;
    }

    .btn-action:hover {
      background: #624396;
    }

    .btn-main {
      width: 100%;
      padding: 14px;
      border: 0;
      border-radius: 10px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      transition: .2s;
      background: linear-gradient(45deg, #00f2fe, #4facfe);
      color: #000;
      box-shadow: 0 4px 15px rgba(0,242,254,.3);
    }

    .btn-main:hover:not(:disabled) {
      opacity: .9;
      transform: translateY(-1px);
    }

    .btn-main:disabled {
      opacity: .5;
      cursor: not-allowed;
      transform: none;
    }

    @media (max-width: 450px) {
      body { padding: 10px; }
      .main-card { padding: 15px; }
      .roulette-wrapper { width: 220px; height: 220px; }
    }
  </style>
</head>

<body>

  <div class="main-card">

    <div class="top-header">
      <h3 class="game-title">CYBER ROULETTE</h3>
      <div>
        金幣: $<span id="user-balance" class="money-display">0</span>
      </div>
    </div>

    <div id="info-text">請選擇下注區域並設定籌碼</div>

    <!-- 輪盤與指針 -->
    <div class="roulette-wrapper">
      <div class="pointer"></div>
      <canvas id="roulette-canvas" width="300" height="300"></canvas>
    </div>

    <!-- 快速下注按鈕區 -->
    <div class="betting-grid">
      <button class="bet-btn red-bg" data-type="red">紅區 (1:1)</button>
      <button class="bet-btn black-bg" data-type="black">黑區 (1:1)</button>
      <button class="bet-btn" data-type="even">雙數 (1:1)</button>
      <button class="bet-btn" data-type="odd">單數 (1:1)</button>
      <button class="bet-btn" data-type="low">小 1-18 (1:1)</button>
      <button class="bet-btn" data-type="high">大 19-36 (1:1)</button>
    </div>

    <!-- 單一數字下注區 -->
    <div class="single-num-box">
      <button class="bet-btn" id="single-btn" data-type="single">指定數字 (35:1)</button>
      <label>選擇號碼:</label>
      <input type="number" id="target-number" min="0" max="36" placeholder="0-36">
    </div>

    <!-- 控制與下注金額區 -->
    <div class="control-box">

      <div class="input-row">
        <div class="input-group">
          <label>兌換序號</label>
          <input type="text" id="promo-code" placeholder="例如 VIP888">
        </div>
        <button class="btn-action" id="redeem-btn">兌換</button>
      </div>

      <div class="input-row">
        <div class="input-group">
          <label>下注金幣</label>
          <input type="number" id="bet-input" value="10" min="1">
        </div>
      </div>

      <button id="spin-btn" class="btn-main">啟動輪盤</button>

    </div>
  </div>

  <script>
    // 採用 IIFE 封裝，防止全域變數遭到竄改
    (function () {
      // 輪盤數字排列 (美式/歐式標準組合)
      const numbers = [
        "0", "32", "15", "19", "4", "21", "2", "25", "17", "34", "6", "27",
        "13", "36", "11", "30", "8", "23", "10", "5", "24", "16", "33", "1",
        "20", "14", "31", "9", "22", "18", "29", "7", "28", "12", "35", "3"
      ];

      const redNumbers = ["1","3","5","7","9","12","14","16","18","19","21","23","25","27","30","32","34","36"];

      // 遊戲資料
      let balance = Number(localStorage.getItem("user_bal")) || 500;
      let usedCodes = JSON.parse(localStorage.getItem("used_codes")) || [];
      let isSpinning = false;
      let selectedBetType = null;

      const rewards = {
        VIP888: 888,
        VIP999: 1000,
        TEST: 50
      };

      // DOM 元素
      const balanceText = document.getElementById("user-balance");
      const infoText = document.getElementById("info-text");
      const canvas = document.getElementById("roulette-canvas");
      const ctx = canvas.getContext("2d");
      const spinBtn = document.getElementById("spin-btn");
      const betInput = document.getElementById("bet-input");
      const promoInput = document.getElementById("promo-code");
      const redeemBtn = document.getElementById("redeem-btn");
      const targetNumInput = document.getElementById("target-number");
      const betBtns = document.querySelectorAll(".bet-btn");

      let currentAngle = 0;

      // 更新餘額顯示
      function refreshBalance() {
        balanceText.textContent = balance;
        localStorage.setItem("user_bal", balance);
      }

      // 繪製輪盤
      function drawRoulette() {
        const numSlices = numbers.length;
        const sliceAngle = (2 * Math.PI) / numSlices;
        const radius = canvas.width / 2;

        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let i = 0; i < numSlices; i++) {
          const angle = currentAngle + i * sliceAngle;
          const num = numbers[i];

          // 設置區塊顏色
          ctx.beginPath();
          ctx.moveTo(radius, radius);
          ctx.arc(radius, radius, radius - 5, angle, angle + sliceAngle);
          ctx.closePath();

          if (num === "0") {
            ctx.fillStyle = "#00ffcc"; // 0 為綠色
          } else if (redNumbers.includes(num)) {
            ctx.fillStyle = "#ff0055"; // 紅區
          } else {
            ctx.fillStyle = "#1f1433"; // 黑區
          }
          ctx.fill();
          ctx.strokeStyle = "#3d2563";
          ctx.stroke();

          // 繪製數字
          ctx.save();
          ctx.translate(radius, radius);
          ctx.rotate(angle + sliceAngle / 2);
          ctx.textAlign = "right";
          ctx.fillStyle = num === "0" ? "#000" : "#fff";
          ctx.font = "bold 12px Arial";
          ctx.fillText(num, radius - 15, 4);
          ctx.restore();
        }

        // 中心圓盤風格
        ctx.beginPath();
        ctx.arc(radius, radius, 25, 0, 2 * Math.PI);
        ctx.fillStyle = "#0b0711";
        ctx.fill();
        ctx.strokeStyle = "#00f2fe";
        ctx.lineWidth = 2;
        ctx.stroke();
      }

      // 選擇下注類型
      betBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          if (isSpinning) return;
          betBtns.forEach(b => b.classList.remove("selected"));
          btn.classList.add("selected");
          selectedBetType = btn.dataset.type;
        });
      });

      // 序號兌換
      function redeemCode() {
        const code = promoInput.value.trim().toUpperCase();
        if (!code) return alert("請輸入兌換序號！");
        if (usedCodes.includes(code)) return alert("此序號已被使用！");
        if (!(code in rewards)) return alert("無效的兌換序號");

        const amount = rewards[code];
        balance += amount;
        usedCodes.push(code);
        localStorage.setItem("used_codes", JSON.stringify(usedCodes));
        refreshBalance();
        promoInput.value = "";
        alert(`兌換成功！獲得 $${amount} 金幣`);
      }

      // 旋轉與判定開獎
      function spin() {
        const betAmount = parseInt(betInput.value);

        if (!selectedBetType) return alert("請先選擇下注區域！");
        if (isNaN(betAmount) || betAmount <= 0) return alert("請輸入有效的下注金額！");
        if (betAmount > balance) return alert("持有金幣不足！");

        let targetSingleNum = null;
        if (selectedBetType === "single") {
          targetSingleNum = parseInt(targetNumInput.value);
          if (isNaN(targetSingleNum) || targetSingleNum < 0 || targetSingleNum > 36) {
            return alert("指定數字請輸入 0 至 36 之間的號碼！");
          }
        }

        balance -= betAmount;
        refreshBalance();

        isSpinning = true;
        spinBtn.disabled = true;
        infoText.textContent = "輪盤轉動中...";

        // 隨機旋轉圈數與角度 (轉動 5 至 8 圈)
        const totalRotation = Math.PI * 2 * (5 + Math.random() * 3);
        const startAngle = currentAngle;
        const duration = 4000; // 4 秒
        const startTime = performance.now();

        function animate(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          
          // 減速緩動函式 (Ease-Out Cubed)
          const easeOut = 1 - Math.pow(1 - progress, 3);
          currentAngle = startAngle + totalRotation * easeOut;
          
          drawRoulette();

          if (progress < 1) {
            requestAnimationFrame(animate);
          } else {
            resolveGame(betAmount, targetSingleNum);
          }
        }

        requestAnimationFrame(animate);
      }

      // 開獎結果計算
      function resolveGame(betAmount, targetSingleNum) {
        isSpinning = false;
        spinBtn.disabled = false;

        // 計算指針 (正上方 -Math.PI/2) 停在哪個數字區塊
        const numSlices = numbers.length;
        const sliceAngle = (2 * Math.PI) / numSlices;
        
        // 將角度正規化至 0 ~ 2PI
        let normalizedAngle = (Math.PI * 1.5 - currentAngle) % (Math.PI * 2);
        if (normalizedAngle < 0) normalizedAngle += Math.PI * 2;

        const winningIndex = Math.floor(normalizedAngle / sliceAngle);
        const winningNumStr = numbers[winningIndex];
        const winningNum = parseInt(winningNumStr);

        let isWin = false;
        let payoutRatio = 0;

        // 判定中獎條件
        if (selectedBetType === "red" && redNumbers.includes(winningNumStr)) {
          isWin = true; payoutRatio = 2; // 包含本金 1:1
        } else if (selectedBetType === "black" && !redNumbers.includes(winningNumStr) && winningNum !== 0) {
          isWin = true; payoutRatio = 2;
        } else if (selectedBetType === "even" && winningNum !== 0 && winningNum % 2 === 0) {
          isWin = true; payoutRatio = 2;
        } else if (selectedBetType === "odd" && winningNum !== 0 && winningNum % 2 !== 0) {
          isWin = true; payoutRatio = 2;
        } else if (selectedBetType === "low" && winningNum >= 1 && winningNum <= 18) {
          isWin = true; payoutRatio = 2;
        } else if (selectedBetType === "high" && winningNum >= 19 && winningNum <= 36) {
          isWin = true; payoutRatio = 2;
        } else if (selectedBetType === "single" && winningNum === targetSingleNum) {
          isWin = true; payoutRatio = 36; // 35:1 賠率
        }

        if (isWin) {
          const prize = betAmount * payoutRatio;
          balance += prize;
          refreshBalance();
          infoText.textContent = `🎯 開出號碼【${winningNumStr}】！恭喜獲得 $${prize} 金幣！`;
        } else {
          infoText.textContent = `💥 開出號碼【${winningNumStr}】，下注失敗！`;
        }
      }

      // 初始化綁定
      redeemBtn.addEventListener("click", redeemCode);
      spinBtn.addEventListener("click", spin);

      refreshBalance();
      drawRoulette();
    })();
  </script>

</body>
</html>
